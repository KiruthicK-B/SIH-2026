# Frontend (onedesk/.env.local) should point at Kong's proxy port, not core-api directly:
# VITE_API_BASE_URL=http://localhost:8010/api
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=onedesk
# VITE_KEYCLOAK_CLIENT_ID=onedesk-frontend

# Everything below is dev-only defaults already baked into docker-compose.yml —
# listed here for reference, not required to `docker compose up`.
POSTGRES_USER=onedesk
POSTGRES_PASSWORD=onedesk
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
