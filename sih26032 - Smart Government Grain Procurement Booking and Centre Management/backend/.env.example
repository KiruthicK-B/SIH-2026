# Server Configuration
PORT=8080
NODE_ENV=development

# Database Connection (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgres://agriva_user:agriva_password_2026@localhost:5433/agriva_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5433
DB_USER=agriva_user
DB_PASSWORD=agriva_password_2026
DB_NAME=agriva_db

# In-Memory Cache & Concurrency Lock (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret & Token Expiry
JWT_SECRET=super_secret_government_agriva_jwt_key_2026
JWT_EXPIRATION_HOURS=24

# Direct Benefit Transfer (DBT) & PFMS Gateway
PFMS_API_ENDPOINT=https://pfms.nic.in/api/v1
PFMS_WEBHOOK_SECRET=pfms_hmac_secret_2026
NPCI_APB_ROUTING_CODE=NPCI0001

# SMS Gateway (C-DAC / NIC)
CDAC_SMS_API_KEY=mock_cdac_key_2026
CDAC_SENDER_ID=AGRIVA

# ngrok public tunnel (npm start uses this to publish a public HTTPS URL and
# write it into agriva/lib/core/config/api_config.dart automatically).
# Get a free authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
# Leave blank to fall back to this machine's LAN IP instead (same-Wi-Fi only).
NGROK_AUTHTOKEN=
